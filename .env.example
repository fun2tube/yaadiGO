# Copy to .env.local for development, and set the same values in your host's
# environment (Vercel project settings, etc.) for production.

# ---------------------------------------------------------------------------
# Database  (PostgreSQL — Supabase)
# ---------------------------------------------------------------------------
# Without this the marketing site, the AI planner and the content editor all
# still work; the CRM does not. Leads, bookings and payments need somewhere
# durable to live — JSON files on a serverless host are wiped on every deploy.
#
# TWO URLs, and using the wrong one is the classic failure:
#
#   DATABASE_URL        the POOLED connection (port 6543, "...pooler...").
#                       Used by the app. A pooler is what stops a few hundred
#                       serverless instances opening a few hundred connections.
#
#   DIRECT_DATABASE_URL the DIRECT connection (port 5432). Used ONLY by
#                       migrations, because a transaction pooler cannot run the
#                       session-level statements DDL needs — and the failure
#                       mode is a migration that half-applies.
#
# Supabase → Project Settings → Database → Connection string.
DATABASE_URL=
DIRECT_DATABASE_URL=

# ---------------------------------------------------------------------------
# AI features — the trip planner (/plan), Yaadi, and the admin editing agent
# ---------------------------------------------------------------------------
# Which service runs them. Everything except `gemini` speaks the OpenAI
# chat-completions format, so they share one adapter (src/lib/ai/providers).
#
#   gemini      Google. Not open-weight, but the most capable free tier.
#   groq        Llama / Qwen / Kimi, free tier, very fast.
#   openrouter  Many open models; the ":free" model suffix is what keeps it free.
#   cerebras    Llama, free tier, fast.
#   together    Open models, free credits.
#   mistral     Mistral's own free tier.
#   ollama      Self-hosted, no key, no quota. Needs real RAM and a GPU.
#   vllm        Self-hosted production server. Set AI_BASE_URL.
#
# Anything else is treated as a custom OpenAI-compatible endpoint and requires
# AI_BASE_URL. Whichever you pick, set its key below; AI_API_KEY works as a
# fallback for all of the OpenAI-compatible ones.
#
# A WORD ON THE OPEN-WEIGHT OPTIONS: Yaadi drives 6 tools and the planner has
# to return a long schema-conformant itinerary. Smaller open models are
# measurably worse at both. Try one, but check that trips, prices and dates in
# the replies match the real data before pointing the public at it.
AI_PROVIDER=gemini

# Optional. Overrides the preset's default model. Model ids on these services
# are retired and renamed often — Gemini's ListModels still advertises
# gemini-2.5-flash, which returns 404 "no longer available to new users" — so
# verify any change with a real request, not a listing.
AI_MODEL=

# Required only for a custom endpoint, ollama or vllm.
AI_BASE_URL=

# Works for every OpenAI-compatible provider. The named ones below take
# precedence when both are set.
AI_API_KEY=

# Get a free key at https://aistudio.google.com/apikey — no card needed, but
# there are per-minute AND per-day caps, and a public lead-magnet site will hit
# them. Enable billing before launch.
#
# Without a key the features still render and degrade honestly — the planner
# says "the planner isn't switched on yet" and points the visitor at the travel
# desk — but nothing is generated.
GEMINI_API_KEY=

# GROQ_API_KEY=         https://console.groq.com/keys
# OPENROUTER_API_KEY=   https://openrouter.ai/keys
# CEREBRAS_API_KEY=     https://cloud.cerebras.ai
# TOGETHER_API_KEY=     https://api.together.ai/settings/api-keys
# MISTRAL_API_KEY=      https://console.mistral.ai/api-keys

# Gemini only. Thinking tokens are billed separately and Flash thinks by default.
# 0 (the default) turns it off for the planner and Yaadi — neither is a
# reasoning problem, and on the free tier thinking is the biggest consumer of
# the per-minute token allowance. -1 lets the model decide.
GEMINI_THINKING_BUDGET=

# Optional. The ADMIN agent thinks by default (-1) because it writes to the
# live site and runs a few times a day rather than continuously. With thinking
# off, Flash invented an off-brand homepage heading and saved it.
GEMINI_ADMIN_THINKING_BUDGET=

# ---------------------------------------------------------------------------
# Scheduled follow-ups  (/api/cron/follow-ups)
# ---------------------------------------------------------------------------
# A public URL that mutates data, so it is gated by a shared secret. Without
# this set the endpoint REFUSES rather than running openly.
#
# Vercel: add to vercel.json —
#   { "crons": [{ "path": "/api/cron/follow-ups", "schedule": "0 4 * * *" }] }
# Vercel sends the value as `Authorization: Bearer <secret>`.
#
# The Chase list in My Day works without any of this — it is computed on read.
# This only drives the automated customer nudges.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Admin / CMS  (/admin)
# ---------------------------------------------------------------------------
# Both are required before the admin will let anyone in. Without them the
# sign-in page says so rather than failing silently.
#
# ADMIN_PASSWORD  — the shared staff password.
# ADMIN_SESSION_SECRET — a long random string used to sign the session cookie.
#   Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   Changing it signs everyone out, which is also how you revoke access.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Enquiries  (contact form, trip builder, and "send this plan to the desk")
# ---------------------------------------------------------------------------
# Where website enquiries are delivered. Any endpoint that accepts a JSON POST
# works — a CRM webhook, Zapier/Make, n8n, or a Google Apps Script web app.
#
# If this is unset the site still accepts enquiries, but they exist ONLY as an
# `[enquiry]` line in the server logs. Set it before launch or you will lose
# leads. See src/app/actions/enquiry.js.
ENQUIRY_WEBHOOK_URL=

# Optional. Sent as `Authorization: Bearer <token>` with the webhook POST.
ENQUIRY_WEBHOOK_TOKEN=

# --- Email -----------------------------------------------------------------
# EITHER of these turns email on. SMTP sends from your own mailbox, so there
# is no sending domain to verify and replies land where the desk already
# looks. Resend is the alternative for volume and needs DNS records first.
#
# Google Workspace / Gmail: create an APP PASSWORD (not the account password)
# at myaccount.google.com/apppasswords, then:
#   SMTP_URL=smtps://info@yaadigo.com:APP_PASSWORD@smtp.gmail.com:465
# Percent-encode any @ : / ? # in the password.
SMTP_URL=
# RESEND_API_KEY=
NOTIFY_FROM_EMAIL=YaadiGo <info@yaadigo.com>
NOTIFY_REPLY_TO=info@yaadigo.com
